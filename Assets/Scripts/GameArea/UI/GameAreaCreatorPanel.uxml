<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
    <ui:VisualElement name="game-area-creator-panel" style="position: absolute; bottom: 20px; left: 20px; background-color: rgba(0,0,0,0.7); padding: 16px; border-radius: 8px; min-width: 280px;">

        <!-- ========== GAME AREA SECTION ========== -->
        <ui:Label text="Create Game Area" style="font-size: 14px; color: white; -unity-font-style: bold; margin-bottom: 12px;" />

        <ui:VisualElement style="flex-direction: row; align-items: center; margin-bottom: 8px;">
            <ui:Label text="Width" style="color: white; width: 60px;" />
            <ui:FloatField name="field-width" value="15" style="flex-grow: 1;" />
        </ui:VisualElement>

        <ui:VisualElement style="flex-direction: row; align-items: center; margin-bottom: 8px;">
            <ui:Label text="Height" style="color: white; width: 60px;" />
            <ui:FloatField name="field-height" value="15" style="flex-grow: 1;" />
        </ui:VisualElement>

        <ui:VisualElement style="flex-direction: row; align-items: center; margin-bottom: 16px;">
            <ui:Label text="Hex Count" style="color: white; width: 60px;" />
            <ui:IntegerField name="field-hex-count" value="25" style="flex-grow: 1;" />
        </ui:VisualElement>

        <ui:Button name="btn-create" text="Create" style="height: 32px; font-size: 13px; -unity-font-style: bold; margin-bottom: 16px;" />

        <!-- ========== DIVIDER ========== -->
        <ui:VisualElement style="border-top: 1px solid rgba(255,255,255,0.3); margin-bottom: 12px; margin-top: 4px;" />

        <!-- ========== UNITS SECTION ========== -->
        <ui:Label text="Initial Units" style="font-size: 14px; color: white; -unity-font-style: bold; margin-bottom: 12px;" />

        <ui:VisualElement style="flex-direction: row; align-items: center; margin-bottom: 8px;">
            <ui:Label text="Unit ID" style="color: white; width: 60px;" />
            <ui:IntegerField name="field-unit-id" value="1" style="flex-grow: 1;" />
        </ui:VisualElement>

        <ui:VisualElement style="flex-direction: row; align-items: center; margin-bottom: 8px;">
            <ui:Label text="Col" style="color: white; width: 60px;" />
            <ui:IntegerField name="field-unit-col" value="0" style="flex-grow: 1;" />
        </ui:VisualElement>

        <ui:VisualElement style="flex-direction: row; align-items: center; margin-bottom: 8px;">
            <ui:Label text="Row" style="color: white; width: 60px;" />
            <ui:IntegerField name="field-unit-row" value="0" style="flex-grow: 1;" />
        </ui:VisualElement>

        <ui:Button name="btn-add-unit" text="Add Unit" style="height: 28px; font-size: 12px; margin-bottom: 12px;" />

        <!-- ========== UNIT LIST ========== -->
        <ui:ScrollView name="unit-list-view" style="min-height: 60px; max-height: 160px; margin-bottom: 12px;">
            <ui:VisualElement name="unit-list-container" style="flex-direction: column; background-color: rgba(255,255,255,0.08); border-radius: 4px; padding: 6px;">
                <ui:Label name="unit-list-empty" text="No units added" style="font-size: 11px; color: rgba(255,255,255,0.5); text-align: center;" />
            </ui:VisualElement>
        </ui:ScrollView>

        <ui:Button name="btn-clear-units" text="Clear Units" style="height: 28px; font-size: 12px; margin-bottom: 12px;" />

    </ui:VisualElement>
</ui:UXML>